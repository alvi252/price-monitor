# Copy to .env and adjust. Every setting is optional; defaults are shown.

# --- What to crawl ---------------------------------------------------------
PM_BASE_URL=https://books.toscrape.com/
# Comma-separated category names exactly as shown in the shop's sidebar.
PM_CATEGORIES=Mystery,Historical Fiction,Science Fiction,Poetry,Food and Drink,Travel
PM_MAX_PAGES_PER_CATEGORY=20

# --- Politeness --------------------------------------------------------------
PM_CONCURRENCY=4
PM_REQUEST_DELAY=0.25
PM_TIMEOUT=15
PM_MAX_RETRIES=3
PM_BACKOFF_BASE=0.5
PM_RESPECT_ROBOTS_TXT=true
# PM_USER_AGENT="my-company-price-monitor/1.0 (+https://example.com/contact)"

# --- Storage & output --------------------------------------------------------
PM_DB_PATH=data/price_monitor.db
PM_REPORTS_DIR=reports

# --- Alerts --------------------------------------------------------------------
# A price change is an alert when it moves by at least this many percent.
PM_ALERT_THRESHOLD_PCT=5
# Also alert on products that appear / disappear (reported either way).
PM_ALERT_ON_NEW_REMOVED=false

# Telegram notifier - enabled only when BOTH values are set.
PM_TELEGRAM_BOT_TOKEN=
PM_TELEGRAM_CHAT_ID=
